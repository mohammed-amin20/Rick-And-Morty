<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- soft portal halo behind the ring -->
    <path android:pathData="M22,54 a32,32 0 1,0 64,0 a32,32 0 1,0 -64,0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="32">
                <item android:offset="0.0" android:color="#66B2DF28" />
                <item android:offset="0.55" android:color="#3397CE4C" />
                <item android:offset="1.0" android:color="#0000B5CC" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- main portal ring -->
    <path
        android:fillType="evenOdd"
        android:pathData="M24,54 a30,30 0 1,0 60,0 a30,30 0 1,0 -60,0 Z M33,54 a21,21 0 1,0 42,0 a21,21 0 1,0 -42,0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="30">
                <item android:offset="0.0" android:color="#FFB2DF28" />
                <item android:offset="0.70" android:color="#FFB2DF28" />
                <item android:offset="0.85" android:color="#FF97CE4C" />
                <item android:offset="1.0" android:color="#FF00B5CC" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- swirling arms -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:rotation="0">
        <path
            android:pathData="M54,33 C 66,34 71,44 69,54 C 67,63 60,64.5 55,61.5 C 51,59 51.5,53.5 55.5,52.5"
            android:strokeWidth="3.2"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:fillColor="#00000000">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:type="linear"
                    android:startX="54"
                    android:startY="33"
                    android:endX="55.5"
                    android:endY="52.5">
                    <item android:offset="0.0" android:color="#FFB2DF28" />
                    <item android:offset="1.0" android:color="#FF00B5CC" />
                </gradient>
            </aapt:attr>
        </path>
    </group>

    <group
        android:pivotX="54"
        android:pivotY="54"
        android:rotation="120">
        <path
            android:pathData="M54,33 C 66,34 71,44 69,54 C 67,63 60,64.5 55,61.5 C 51,59 51.5,53.5 55.5,52.5"
            android:strokeWidth="3.2"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:fillColor="#00000000">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:type="linear"
                    android:startX="54"
                    android:startY="33"
                    android:endX="55.5"
                    android:endY="52.5">
                    <item android:offset="0.0" android:color="#FFB2DF28" />
                    <item android:offset="1.0" android:color="#FF00B5CC" />
                </gradient>
            </aapt:attr>
        </path>
    </group>

    <group
        android:pivotX="54"
        android:pivotY="54"
        android:rotation="240">
        <path
            android:pathData="M54,33 C 66,34 71,44 69,54 C 67,63 60,64.5 55,61.5 C 51,59 51.5,53.5 55.5,52.5"
            android:strokeWidth="3.2"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:fillColor="#00000000">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:type="linear"
                    android:startX="54"
                    android:startY="33"
                    android:endX="55.5"
                    android:endY="52.5">
                    <item android:offset="0.0" android:color="#FFB2DF28" />
                    <item android:offset="1.0" android:color="#FF00B5CC" />
                </gradient>
            </aapt:attr>
        </path>
    </group>

    <!-- glowing core -->
    <path android:pathData="M46,54 a8,8 0 1,0 16,0 a8,8 0 1,0 -16,0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="8">
                <item android:offset="0.0" android:color="#E6FFFFFF" />
                <item android:offset="0.35" android:color="#B3B2DF28" />
                <item android:offset="1.0" android:color="#00B2DF28" />
            </gradient>
        </aapt:attr>
    </path>
    <path android:pathData="M50.5,54 a3.5,3.5 0 1,0 7,0 a3.5,3.5 0 1,0 -7,0 Z" android:fillColor="#FFEAFB9A" />
    <path android:pathData="M52.6,54 a1.4,1.4 0 1,0 2.8,0 a1.4,1.4 0 1,0 -2.8,0 Z" android:fillColor="#FFFFFFFF" />
</vector>
